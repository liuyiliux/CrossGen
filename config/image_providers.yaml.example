# 图像生成提供商配置文件
# 支持多种AI图像生成服务的配置

providers:
  # OpenAI DALL·E 配置
  dall_e:
    enabled: true
    api_key: "${OPENAI_API_KEY}"
    base_url: "https://api.openai.com/v1"
    model: "dall-e-3"
    quality: "standard"  # standard, hd
    size_config:
      xiaohongshu: ["1024x1792", "1792x1024"]
      douyin: ["1024x1792"]
      wechat: ["1792x1024"]
      toutiao: ["1024x1024"]
    timeout: 60
    retry_count: 2
    headers:
      "Content-Type": "application/json"
      "Authorization": "Bearer ${OPENAI_API_KEY}"
    
  # Stable Diffusion 配置
  stable_diffusion:
    enabled: false
    api_key: "${SD_API_KEY}"
    base_url: "http://localhost:7860/sdapi/v1"
    model: "stable-diffusion-xl"
    width: 1024
    height: 1024
    steps: 20
    cfg_scale: 7
    sampler_name: "DPM++ 2M Karras"
    batch_size: 1
    timeout: 120
    retry_count: 2
    negative_prompt: "low quality, blurry, distorted, ugly"
    
  # Midjourney 配置
  midjourney:
    enabled: false
    api_key: "${MIDJOURNEY_API_KEY}"
    base_url: "https://api.midjourney.com/v1"
    model: "midjourney-v6"
    quality: "high"
    style: "natural"
    aspect_ratios:
      xiaohongshu: "2:3"
      douyin: "9:16"
      wechat: "16:9"
      toutiao: "1:1"
    timeout: 180
    retry_count: 1
    
  # 百度文心一格配置
  wenyi:
    enabled: false
    api_key: "${WENYI_API_KEY}"
    secret_key: "${WENYI_SECRET_KEY}"
    base_url: "https://aip.baidubce.com"
    model: "wenyi-v3"
    width: 1024
    height: 1024
    timeout: 60
    retry_count: 2
    
  # 百炼通用配置示例（使用generic类型）
  bailian:
    type: generic
    enabled: true
    api_key: "${BAILIAN_API_KEY}"
    base_url: "https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation"
    model: "z-image-turbo"
    timeout: 120
    retry_count: 3
    # 请求配置
    request_config:
      template: |
        {
          "model": "{{ model }}",
          "input": {
            "messages": [
              {
                "role": "user",
                "content": [
                  {
                    "text": "{{ prompt }}"
                  }
                ]
              }
            ]
          },
          "parameters": {
            "size": "{{ size }}",
            "prompt_extend": false,
            "negative_prompt": ""
          }
        }
      # 参数默认值
      defaults:
        size: "1024*1024"
        n: 1
      # 参数转换规则
      parameter_transforms:
        # 将x分隔的尺寸转换为*分隔
        size: "{{ size.replace('x', '*') }}"
    # 响应解析配置
    response_config:
      # 提取图像URL的JSONPath
      images_path: "$.output.images[*].url"
      # 提取使用信息的JSONPath
      usage_path: "$.usage"
      # 提取错误信息的JSONPath
      error_path: "$.error.message"
    # 尺寸配置
    size_config:
      # 总像素范围
      total_pixels:
        min: "512*512"
        max: "2048*2048"
      # 推荐总像素范围
      recommended_total_pixels:
        min: "1024*1024"
        max: "1536*1536"
      # 支持的宽高比
      supported_aspect_ratios:
        - "1:1"
        - "2:3"
        - "3:2"
        - "3:4"
        - "4:3"
        - "7:9"
        - "9:7"
        - "9:16"
        - "9:21"
        - "16:9"
        - "21:9"
      # 推荐分辨率列表
      recommended_resolutions:
        - "1024*1024"
        - "1120*1440"
        - "1440*1120"
        - "1280*1280"
        - "1024*1536"
        - "1536*1024"
    # 支持的尺寸列表
    supported_sizes:
      - "1024*1024"
      - "1120*1440"
      - "1440*1120"
      - "1280*1280"
      - "1024*1536"
      - "1536*1024"
      - "1536*1536"
      - "720*1280"
      - "1280*720"
      - "576*1344"
      - "1344*576"
      - "864*1536"
      - "1536*864"
      - "896*1152"
      - "1152*896"
      - "1024*1792"
      - "1792*1024"

# 提示词增强配置
prompt_enhancement:
  # 小红书风格增强
  xiaohongshu:
    style_keywords: ["ins", "trending", "aesthetic", "vibrant", "lifestyle"]
    quality_keywords: ["high quality", "detailed", "sharp focus", "professional"]
    lighting_keywords: ["soft lighting", "natural light", "bright"]
    composition_keywords: ["centered", "balanced", "rule of thirds"]
    
  # 抖音风格增强
  douyin:
    style_keywords: ["dynamic", "energetic", "bold", "attention-grabbing"]
    quality_keywords: ["4k", "ultra detailed", "cinematic"]
    lighting_keywords: ["dramatic lighting", "vibrant colors"]
    composition_keywords: ["close-up", "eye-level", "engaging"]
    
  # 微信公众号风格增强
  wechat:
    style_keywords: ["professional", "clean", "informative", "editorial"]
    quality_keywords: ["high resolution", "crisp", "well-composed"]
    lighting_keywords: ["even lighting", "professional"]
    composition_keywords: ["wide shot", "informative layout"]
    
  # 头条号风格增强
  toutiao:
    style_keywords: ["news-style", "documentary", "authentic", "journalistic"]
    quality_keywords: ["realistic", "detailed", "clear"]
    lighting_keywords: ["natural", "available light"]
    composition_keywords: ["news photography", "storytelling"]

# 图像后处理配置
post_processing:
  # 基础调整
  basic_adjustments:
    brightness: 0  # -100 to 100
    contrast: 0    # -100 to 100
    saturation: 0   # -100 to 100
    sharpness: 0    # -100 to 100
    
  # 水印配置
  watermark:
    enabled: false
    text: "逸流生成"
    position: "bottom_right"  # bottom_left, bottom_right, top_left, top_right, center
    opacity: 0.5
    font_size: 24
    color: "#FFFFFF"
    
  # 尺寸调整
  resizing:
    maintain_aspect_ratio: true
    upscale_method: "lanczos"  # nearest, bilinear, bicubic, lanczos
    downscale_method: "area"    # nearest, bilinear, bicubic, area

# 内容安全配置
content_safety:
  enabled: true
  filters:
    - "violence"
    - "adult_content"
    - "hate_speech"
    - "illegal_content"
  action: "block"  # block, blur, warn

# 性能优化配置
performance:
  # 并发控制
  concurrent_requests:
    max_concurrent: 3
    queue_size: 10
    timeout_per_request: 120
    
  # 缓存配置
  cache:
    enabled: true
    ttl: 86400  # 24小时
    max_size: 500
    storage_type: "memory"  # memory, redis, file
    
  # 预热配置
  warmup:
    enabled: false
    common_prompts:
      - "beautiful landscape"
      - "modern interior design"
      - "fashion photography"

# 平台映射配置
platform_mapping:
  xiaohongshu:
    primary_provider: "dall_e"
    fallback_provider: "stable_diffusion"
    aspect_ratio: "2:3"
    
  douyin:
    primary_provider: "dall_e"
    fallback_provider: "stable_diffusion"
    aspect_ratio: "9:16"
    
  wechat:
    primary_provider: "dall_e"
    fallback_provider: "stable_diffusion"
    aspect_ratio: "16:9"
    
  toutiao:
    primary_provider: "dall_e"
    fallback_provider: "stable_diffusion"
    aspect_ratio: "1:1"

# 质量控制配置
quality_control:
  # 质量检查
  quality_check:
    enabled: true
    min_resolution: 512
    max_file_size: 10485760  # 10MB
    allowed_formats: ["png", "jpg", "jpeg", "webp"]
    
  # 自动重试配置
  auto_retry:
    enabled: true
    max_retries: 2
    retry_conditions:
      - "low_quality_score"
      - "content_filter_triggered"
      - "generation_error"
    
  # 质量评分阈值
  quality_thresholds:
    min_score: 0.7
    aesthetic_threshold: 0.6
    technical_threshold: 0.8